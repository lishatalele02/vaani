# ---- Gnani AI (keep real keys ONLY in backend/.env, never commit) ----
# One key, or several separated by commas (used in rotation with automatic failover)
GNANI_API_KEY=
GNANI_API_KEYS=

# Speech-to-text: Prisma v3.0 - docs: https://docs.gnani.ai/api/STT/speech-to-text
# language_code may be indic-auto or 1-4 codes; itn_native_numerals has no effect on v3.0 (removed).
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_KEY_HEADER=X-API-Key-ID
GNANI_STT_KEY_PREFIX=
GNANI_STT_AUDIO_FIELD=audio_file
GNANI_STT_LANGUAGE_FIELD=language_code
GNANI_STT_FORMAT_FIELD=format
GNANI_STT_FORMAT_VALUE=transcribe
GNANI_STT_EXTRA_FIELDS_JSON={"model":"prisma-v3.0"}
# Send the user's saved phrases / names to Prisma as `keyterms` hints (max 200).
# Gnani warns hints can occasionally hurt accuracy: measure with scripts/eval_keyterms.py.
GNANI_KEYTERMS=true
GNANI_KEYTERMS_MAX=200

# Text-to-speech: Timbre v3.0 - docs: https://docs.gnani.ai/api/TTS/tts-inference
# Voices are model specific. timbre-v3.0 has 13 voices that each speak all 10 languages incl. Marathi:
#   Avinash, Shivani, Lakshmi, Kalpana, Shubham, Prakash, Devansh, Yashraj, Chetana, Vasudha, Riyaa, Tarika, Harshad
# For timbre-v2.5 use e.g. GNANI_TTS_MODEL=timbre-v2.5, GNANI_TTS_VOICE=Nalini, GNANI_TTS_VOICES=Nalini,Kaveri,Deepak,Poorvi
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_SSE_URL=https://api.vachana.ai/api/v1/tts/sse
GNANI_TTS_KEY_HEADER=X-API-Key-ID
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_VOICES=Avinash,Shivani,Lakshmi,Kalpana,Shubham,Prakash,Devansh,Yashraj,Chetana,Vasudha,Riyaa,Tarika,Harshad
GNANI_TTS_SPEED=1.0
GNANI_TTS_AUDIO_CONFIG_JSON={"sample_rate":48000,"num_channels":1,"sample_width":2,"encoding":"linear_pcm","container":"wav"}

# Gnani accounts may allow only ONE active request at a time
GNANI_MAX_CONCURRENCY=1
GNANI_TIMEOUT_SECONDS=60

# ---- App ----
SAMAJH_DB_PATH=./samajh_sakhi.sqlite3
MAX_UPLOAD_MB=10
# Per-user daily limits
DAILY_STT_LIMIT=200
DAILY_TTS_LIMIT=400
# Whole-server daily caps so a public demo cannot drain your Gnani credits (0 = off)
GLOBAL_DAILY_STT_LIMIT=1500
GLOBAL_DAILY_TTS_LIMIT=2500
# Access code the app must send to create an account. REQUIRED for any public/judge demo.
REGISTRATION_CODE=
# true = refuse to start when REGISTRATION_CODE is empty (use this on your hosted server)
REQUIRE_ACCESS_CODE=false

# Translating free text between Marathi/Hindi/English uses the free MyMemory service (only the message text is sent).
# Ready-made messages are always translated from the built-in catalog without any internet service.
TRANSLATE_FALLBACK=true
DAILY_TRANSLATE_LIMIT=300
